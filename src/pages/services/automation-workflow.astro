---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Business Process Automation UK | QSol Analytics"
  description="Manual reporting eating your week? Automation services that give operations teams their time back. Pipelines, tools, and audits in 2-4 weeks."
>
  <section class="py-16 lg:py-24">
    <div class="container-narrow">
      <h1 class="text-4xl font-bold text-slate">Operational Data Systems</h1>
      <p class="mt-6 text-xl text-slate-light">
        Business process automation, internal tools, and diagnostic services that remove manual work and give your team real-time visibility. Python automation services tailored for UK SMEs—three practical offerings to match where you are now.
      </p>
    </div>
  </section>

  <!-- Offer 1: Reporting & Workflow Automation -->
  <section id="reporting-automation" class="py-16 lg:py-20 bg-gray-50">
    <div class="container-narrow">
      <div class="flex items-center gap-4 mb-4">
        <span class="text-sm font-medium text-brand-blue bg-brand-blue-pale px-3 py-1 rounded-full">2–4 weeks</span>
      </div>
      <h2 class="text-3xl font-bold text-slate">Reporting & Workflow Automation</h2>
      <p class="mt-4 text-lg text-slate-light">
        We automate the recurring reporting and data-handling work that slows teams down. Reporting automation consultancy for small businesses—from spreadsheet consolidation to fully automated pipelines.
      </p>

      <div class="mt-8 grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="font-semibold text-slate text-lg">The Problem</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Reports take hours to produce every week or month
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Important data lives in multiple disconnected places
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Manual copy-paste introduces errors
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Teams cannot see issues until too late
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-slate text-lg">What You Get</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Automated reporting pipeline
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Data validation rules and error flags
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Dashboard or output report template
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Documentation and handover notes
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-8 bg-white border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-slate">Typical Examples</h3>
        <ul class="mt-3 grid md:grid-cols-2 gap-2 text-sm text-slate-light">
          <li>Weekly operations report built from multiple spreadsheets</li>
          <li>Site-visit data cleaned and turned into reporting pack</li>
          <li>Finance and operations files merged into KPI summary</li>
          <li>Missing entries flagged before affecting downstream work</li>
        </ul>
      </div>

      <div class="mt-8 flex flex-col sm:flex-row gap-4 items-start">
        <a href="https://cal.com/q-types/30-minute-discovery-call" class="btn-primary">
          Identify reporting work that should be automated
        </a>
        <a href="/case-studies/" class="text-brand-blue font-medium hover:underline flex items-center gap-1">
          See automation case study
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Offer 2: Decision-Support Tools & Internal Apps -->
  <section id="decision-tools" class="py-16 lg:py-20">
    <div class="container-narrow">
      <div class="flex items-center gap-4 mb-4">
        <span class="text-sm font-medium text-brand-blue bg-brand-blue-pale px-3 py-1 rounded-full">3–8 weeks</span>
      </div>
      <h2 class="text-3xl font-bold text-slate">Decision-Support Tools & Internal Apps</h2>
      <p class="mt-4 text-lg text-slate-light">
        We build practical internal tools that turn repeated calculations and decisions into usable systems.
      </p>

      <div class="mt-8 grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="font-semibold text-slate text-lg">The Problem</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Important calculations live in fragile spreadsheets
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Decisions depend on one experienced person
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Processes are inconsistent across staff
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Valuable business rules are not encoded anywhere usable
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-slate text-lg">What You Get</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Web app or internal interface
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Logic model with your business rules encoded
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Clear input and output definitions
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              User guidance and documentation
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-8 bg-gray-50 border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-slate">Typical Examples</h3>
        <ul class="mt-3 grid md:grid-cols-2 gap-2 text-sm text-slate-light">
          <li>Manufacturing estimator</li>
          <li>Quote builder for complex services</li>
          <li>Scheduling and resource helper</li>
          <li>Operational calculator with dashboard outputs</li>
        </ul>
      </div>

      <div class="mt-8 flex flex-col sm:flex-row gap-4 items-start">
        <a href="https://cal.com/q-types/30-minute-discovery-call" class="btn-primary">
          Discuss the spreadsheet that should become a real tool
        </a>
        <a href="/case-studies/" class="text-brand-blue font-medium hover:underline flex items-center gap-1">
          See estimator case study
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Offer 3: Data & AI Readiness Audits -->
  <section id="data-audit" class="py-16 lg:py-20 bg-brand-blue-pale">
    <div class="container-narrow">
      <div class="flex items-center gap-4 mb-4">
        <span class="text-sm font-medium text-brand-blue bg-white px-3 py-1 rounded-full">1–5 days</span>
        <span class="text-sm font-medium text-green-700 bg-green-100 px-3 py-1 rounded-full">Low-risk entry point</span>
      </div>
      <h2 class="text-3xl font-bold text-slate">Data & AI Readiness Audit</h2>
      <p class="mt-4 text-lg text-slate-light">
        We review your current data, reporting, and workflow setup and show where better systems would create the most value.
      </p>

      <div class="mt-8 grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="font-semibold text-slate text-lg">The Problem</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Data is messy and fragmented
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Not sure where to start or what's worth fixing first
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              AI discussions are vague and unprioritised
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Previous digital projects stalled or disappointed
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-slate text-lg">What You Get</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Short written audit report
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Prioritised opportunities list
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Feasibility and readiness assessment
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Recommended roadmap
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-8 bg-white border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-slate">Best For</h3>
        <p class="mt-2 text-slate-light">
          SMEs at the start of a data improvement journey. Businesses with messy or fragmented systems. Teams considering automation or AI but needing a roadmap first.
        </p>
        <p class="mt-4 text-sm text-slate-light italic">
          The audit fee applies to any follow-on project if you proceed—making this a risk-free way to start.
        </p>
      </div>

      <div class="mt-8">
        <a href="https://cal.com/q-types/30-minute-discovery-call" class="btn-primary">
          Get a grounded view of what your data can support
        </a>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-16 lg:py-20">
    <div class="container-narrow">
      <h2 class="text-3xl font-bold text-slate text-center">How It Works</h2>
      <div class="mt-12 space-y-8">
        <div class="flex gap-6">
          <div class="flex-shrink-0 w-12 h-12 bg-brand-blue text-white rounded-full flex items-center justify-center font-bold">1</div>
          <div>
            <h3 class="font-semibold text-slate">Discovery Call (30 min)</h3>
            <p class="mt-2 text-slate-light">We identify your highest-impact opportunities. You leave with clarity, not a sales pitch.</p>
          </div>
        </div>
        <div class="flex gap-6">
          <div class="flex-shrink-0 w-12 h-12 bg-brand-blue text-white rounded-full flex items-center justify-center font-bold">2</div>
          <div>
            <h3 class="font-semibold text-slate">Assessment (1-3 days)</h3>
            <p class="mt-2 text-slate-light">We map your current workflow and design the improved version.</p>
          </div>
        </div>
        <div class="flex gap-6">
          <div class="flex-shrink-0 w-12 h-12 bg-brand-blue text-white rounded-full flex items-center justify-center font-bold">3</div>
          <div>
            <h3 class="font-semibold text-slate">Build (2-8 weeks)</h3>
            <p class="mt-2 text-slate-light">We build, test, and deploy the solution with your real data.</p>
          </div>
        </div>
        <div class="flex gap-6">
          <div class="flex-shrink-0 w-12 h-12 bg-brand-blue text-white rounded-full flex items-center justify-center font-bold">4</div>
          <div>
            <h3 class="font-semibold text-slate">Handover</h3>
            <p class="mt-2 text-slate-light">Full documentation, training, and optional ongoing support. You choose.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Ready to streamline operations?"
    description="Book a discovery call to identify your highest-ROI opportunities."
  />

  <!-- Service Schema with multiple offers -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Operational Data Systems",
    "description": "Automation pipelines, internal tools, and data audits that eliminate manual work and give your team real-time visibility.",
    "provider": {
      "@type": "ProfessionalService",
      "name": "QSol Analytics",
      "url": "https://qsol-analytics.com"
    },
    "areaServed": {
      "@type": "Country",
      "name": "United Kingdom"
    },
    "serviceType": "Business Automation",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Operational Data Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Reporting & Workflow Automation",
            "description": "Automated reporting pipelines that save 10-15 hours per week"
          },
          "priceSpecification": {
            "@type": "PriceSpecification",
            "priceCurrency": "GBP",
            "minPrice": "3000",
            "maxPrice": "8000"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Decision-Support Tools & Internal Apps",
            "description": "Estimators, quote builders, and calculators that embed your business logic"
          },
          "priceSpecification": {
            "@type": "PriceSpecification",
            "priceCurrency": "GBP",
            "minPrice": "5000",
            "maxPrice": "15000"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Data & AI Readiness Audit",
            "description": "Prioritised roadmap showing highest-ROI automation and AI opportunities"
          },
          "priceSpecification": {
            "@type": "PriceSpecification",
            "priceCurrency": "GBP",
            "minPrice": "1500",
            "maxPrice": "3000"
          }
        }
      ]
    }
  })} />
</BaseLayout>
