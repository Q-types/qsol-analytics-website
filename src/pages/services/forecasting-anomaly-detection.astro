---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Demand Forecasting & Anomaly Detection | QSol Analytics"
  description="Plan ahead with confidence. Forecasting models and anomaly detection systems for UK SMEs. Catch problems before they cost you. Results in 3-6 weeks."
>
  <section class="py-16 lg:py-24">
    <div class="container-narrow">
      <h1 class="text-4xl font-bold text-slate">Predictive Analytics & Forecasting</h1>
      <p class="mt-6 text-xl text-slate-light">
        Demand forecasting and anomaly detection for UK SMEs. Two distinct services: <strong>forecasting</strong> estimates future states so you can plan ahead; <strong>anomaly detection</strong> flags present deviations so you can respond faster. Time-series forecasting for business—choose what fits your challenge.
      </p>
    </div>
  </section>

  <!-- Offer 1: Forecasting Services -->
  <section id="forecasting" class="py-16 lg:py-20 bg-gray-50">
    <div class="container-narrow">
      <div class="flex items-center gap-4 mb-4">
        <span class="text-sm font-medium text-brand-blue bg-brand-blue-pale px-3 py-1 rounded-full">3–6 weeks</span>
      </div>
      <h2 class="text-3xl font-bold text-slate">Forecasting Services</h2>
      <p class="mt-4 text-lg text-slate-light">
        Sales forecasting, demand forecasting, and workload prediction—we build forecasting tools that help you plan ahead using your real business data.
      </p>

      <div class="mt-8 grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="font-semibold text-slate text-lg">The Problem</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Planning is based on instinct or last month's numbers
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Seasonal effects are poorly understood
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Teams are often over- or under-prepared
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Demand changes are noticed too late
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-slate text-lg">What You Get</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Baseline forecast model
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Forecast accuracy summary
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Dashboard with confidence/uncertainty bands
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Guidance on interpretation and use
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-8 bg-white border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-slate">What Forecasting Helps You Plan</h3>
        <ul class="mt-3 grid md:grid-cols-2 gap-2 text-sm text-slate-light">
          <li>Seasonal product demand</li>
          <li>Incoming quote volume by week</li>
          <li>Workload for staffing decisions</li>
          <li>Sales pipeline and revenue</li>
          <li>Cash flow and working capital</li>
          <li>Material and inventory requirements</li>
        </ul>
      </div>

      <div class="mt-6 bg-green-50 border border-green-200 rounded-lg p-4">
        <p class="text-sm text-green-800">
          <strong>Typical results:</strong> 15-30% reduction in stockouts, 15-25% reduction in overstock, earlier visibility of demand changes.
        </p>
        <p class="text-xs text-green-700 mt-1 italic">Results vary by data quality. We agree success metrics upfront.</p>
      </div>

      <div class="mt-8 bg-gray-100 border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-slate">What We Need From You</h3>
        <ul class="mt-3 space-y-1 text-sm text-slate-light">
          <li>Historical time-stamped data (sales, demand, activity)</li>
          <li>Definition of what you want to forecast</li>
          <li>Context on promotions, outages, or special events</li>
        </ul>
      </div>

      <div class="mt-8">
        <a href="https://cal.com/q-types/30-minute-discovery-call" class="btn-primary">
          Explore where better forecasting could reduce waste
        </a>
      </div>
    </div>
  </section>

  <!-- Offer 2: Anomaly Detection & Monitoring -->
  <section id="anomaly-detection" class="py-16 lg:py-20">
    <div class="container-narrow">
      <div class="flex items-center gap-4 mb-4">
        <span class="text-sm font-medium text-brand-blue bg-brand-blue-pale px-3 py-1 rounded-full">3–6 weeks</span>
      </div>
      <h2 class="text-3xl font-bold text-slate">Anomaly Detection & Monitoring</h2>
      <p class="mt-4 text-lg text-slate-light">
        We build systems that flag unusual activity in your data so issues can be reviewed earlier.
      </p>

      <div class="mt-8 grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="font-semibold text-slate text-lg">The Problem</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Irregular events are easy to miss in large datasets
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Teams detect problems late—after they've caused cost
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Manual review doesn't scale
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              There's no reliable early-warning mechanism
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-slate text-lg">What You Get</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Monitoring rules or anomaly model
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Alert logic and thresholds
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Review dashboard or flagged report
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Documentation on how to interpret signals
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-8 bg-gray-50 border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-slate">Where Anomaly Detection Helps</h3>
        <ul class="mt-3 grid md:grid-cols-2 gap-2 text-sm text-slate-light">
          <li>Unusual stock movement</li>
          <li>Irregular process readings</li>
          <li>Unexpected site-monitoring patterns</li>
          <li>Abnormal transaction behaviour</li>
          <li>Quality or measurement drift</li>
          <li>Operational threshold breaches</li>
        </ul>
      </div>

      <div class="mt-6 bg-green-50 border border-green-200 rounded-lg p-4">
        <p class="text-sm text-green-800">
          <strong>Typical results:</strong> Earlier warnings, faster response, lower incident costs. Problems caught before escalation rather than after.
        </p>
      </div>

      <div class="mt-8 bg-gray-100 border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-slate">What We Need From You</h3>
        <ul class="mt-3 space-y-1 text-sm text-slate-light">
          <li>Historical observations or transactions</li>
          <li>Known examples of abnormal events if available</li>
          <li>Process thresholds or operational expectations</li>
        </ul>
      </div>

      <div class="mt-8">
        <a href="https://cal.com/q-types/30-minute-discovery-call" class="btn-primary">
          Explore where earlier warning would protect margin
        </a>
      </div>
    </div>
  </section>

  <!-- How We Approach It -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="container-narrow">
      <h2 class="text-3xl font-bold text-slate text-center">Our Approach</h2>
      <p class="mt-4 text-center text-slate-light max-w-2xl mx-auto">
        We use proven methods—from classical statistics to modern machine learning—chosen based on your data, not our preference.
      </p>
      <div class="mt-10 grid md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-lg border border-gray-200">
          <h3 class="font-semibold text-slate">Explainable</h3>
          <p class="mt-2 text-sm text-slate-light">You understand why it predicts what it predicts. No black boxes.</p>
        </div>
        <div class="bg-white p-6 rounded-lg border border-gray-200">
          <h3 class="font-semibold text-slate">Validated</h3>
          <p class="mt-2 text-sm text-slate-light">Tested on historical data before deployment. You see accuracy upfront.</p>
        </div>
        <div class="bg-white p-6 rounded-lg border border-gray-200">
          <h3 class="font-semibold text-slate">Practical</h3>
          <p class="mt-2 text-sm text-slate-light">Integrated into your workflow, not a standalone curiosity.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Ready to plan ahead or catch problems earlier?"
    description="Book a discovery call to discuss your forecasting or monitoring challenges."
  />

  <!-- Service Schema with multiple offers -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Predictive Analytics & Forecasting",
    "description": "Models that forecast demand and detect operational risk. Time-series forecasting and anomaly detection for UK SMEs.",
    "provider": {
      "@type": "ProfessionalService",
      "name": "QSol Analytics",
      "url": "https://qsol-analytics.com"
    },
    "areaServed": {
      "@type": "Country",
      "name": "United Kingdom"
    },
    "serviceType": "Predictive Analytics",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Predictive Analytics Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Forecasting Services",
            "description": "Demand, sales, or workload forecasts with confidence intervals"
          },
          "priceSpecification": {
            "@type": "PriceSpecification",
            "priceCurrency": "GBP",
            "minPrice": "5000",
            "maxPrice": "15000"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Anomaly Detection & Monitoring",
            "description": "Early-warning systems that flag unusual patterns automatically"
          },
          "priceSpecification": {
            "@type": "PriceSpecification",
            "priceCurrency": "GBP",
            "minPrice": "5000",
            "maxPrice": "15000"
          }
        }
      ]
    }
  })} />
</BaseLayout>
