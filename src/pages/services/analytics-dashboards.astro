---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="AI Consultant UK | NLP & AI Assistants | QSol Analytics"
  description="NLP solutions and internal AI assistants grounded on your documents. Practical AI for UK SMEs—no hype, just useful systems. Results in 2-6 weeks."
>
  <section class="py-16 lg:py-24">
    <div class="container-narrow">
      <h1 class="text-4xl font-bold text-slate">AI & Intelligent Automation</h1>
      <p class="mt-6 text-xl text-slate-light">
        AI consulting for UK small businesses. Two distinct services: <strong>NLP solutions</strong> that simplify text-heavy workflows, and <strong>internal AI assistants</strong> that help your team find answers in your own documents. Practical AI tools for SMEs—no hype, just useful systems.
      </p>
    </div>
  </section>

  <!-- Offer 1: Lightweight NLP Solutions -->
  <section id="nlp-solutions" class="py-16 lg:py-20 bg-gray-50">
    <div class="container-narrow">
      <div class="flex items-center gap-4 mb-4">
        <span class="text-sm font-medium text-brand-blue bg-brand-blue-pale px-3 py-1 rounded-full">2–6 weeks</span>
      </div>
      <h2 class="text-3xl font-bold text-slate">Lightweight NLP Solutions</h2>
      <p class="mt-4 text-lg text-slate-light">
        We build text-processing tools that help teams organise, search, and act on written information.
      </p>

      <div class="mt-8 grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="font-semibold text-slate text-lg">The Problem</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Written feedback is hard to summarise consistently
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Manual categorisation is slow
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Documents are difficult to search properly
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Teams lose time reading and triaging repetitive text inputs
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-slate text-lg">What You Get</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Text processing workflow
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Label set or classification scheme
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Search or retrieval interface
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Human review workflow where appropriate
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-8 bg-white border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-slate">What NLP Tools Can Do</h3>
        <ul class="mt-3 grid md:grid-cols-2 gap-2 text-sm text-slate-light">
          <li>Group customer feedback by theme</li>
          <li>Route incoming emails by topic or urgency</li>
          <li>Search internal documents by meaning, not just keywords</li>
          <li>Extract common issues from support notes</li>
          <li>Categorise complaints or enquiries automatically</li>
          <li>Summarise survey responses</li>
        </ul>
      </div>

      <div class="mt-6 bg-green-50 border border-green-200 rounded-lg p-4">
        <p class="text-sm text-green-800">
          <strong>Value:</strong> Makes text-heavy workflows faster, more consistent, and easier to scale.
        </p>
      </div>

      <div class="mt-8 bg-gray-100 border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-slate">What We Need From You</h3>
        <ul class="mt-3 space-y-1 text-sm text-slate-light">
          <li>Example text data (emails, feedback, documents)</li>
          <li>Desired categories or outputs</li>
          <li>Human review criteria</li>
          <li>Access rules for documents or messages</li>
        </ul>
      </div>

      <div class="mt-8">
        <a href="https://cal.com/q-types/30-minute-discovery-call" class="btn-primary">
          Discuss whether your text-heavy workflow can be simplified
        </a>
      </div>
    </div>
  </section>

  <!-- Offer 2: Internal AI Assistants -->
  <section id="ai-assistants" class="py-16 lg:py-20">
    <div class="container-narrow">
      <div class="flex items-center gap-4 mb-4">
        <span class="text-sm font-medium text-brand-blue bg-brand-blue-pale px-3 py-1 rounded-full">3–6 weeks</span>
      </div>
      <h2 class="text-3xl font-bold text-slate">Internal AI Assistants</h2>
      <p class="mt-4 text-lg text-slate-light">
        We build internal assistants that help your team find answers inside your own approved documents. Grounded, cited, and narrow—not a free-form AI that makes things up.
      </p>

      <div class="mt-8 grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="font-semibold text-slate text-lg">The Problem</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Information exists but is hard to retrieve
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Teams waste time searching through folders and PDFs
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Knowledge is trapped with a few experienced staff
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Generic AI tools hallucinate or answer without source grounding
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-slate text-lg">What You Get</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Controlled document ingestion pipeline
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Retrieval interface or chat interface
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Citation/source display with every answer
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Human review guidance and usage policy
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-8 bg-gray-50 border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-slate">What Internal Assistants Can Do</h3>
        <ul class="mt-3 grid md:grid-cols-2 gap-2 text-sm text-slate-light">
          <li>Ask questions about company SOPs</li>
          <li>Search policies and procedures</li>
          <li>Find technical guidance in manuals</li>
          <li>Draft outputs from approved templates</li>
          <li>Support onboarding with consistent answers</li>
          <li>Retrieve estimating rules or sales guidance</li>
        </ul>
      </div>

      <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
        <h3 class="font-semibold text-slate text-sm">What Makes This Different</h3>
        <ul class="mt-2 text-sm text-slate-light space-y-1">
          <li><strong>Grounded:</strong> Answers come from your approved documents, not the internet</li>
          <li><strong>Cited:</strong> Every answer shows where it came from</li>
          <li><strong>Narrow:</strong> Scoped to your knowledge base, not general-purpose chat</li>
          <li><strong>Reviewable:</strong> Built with audit and oversight in mind</li>
        </ul>
      </div>

      <div class="mt-6 bg-green-50 border border-green-200 rounded-lg p-4">
        <p class="text-sm text-green-800">
          <strong>Value:</strong> Saves search time, improves access to internal knowledge, and helps teams use existing documents more effectively—without pretending the system replaces staff judgment.
        </p>
      </div>

      <div class="mt-8 bg-gray-100 border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-slate">What We Need From You</h3>
        <ul class="mt-3 space-y-1 text-sm text-slate-light">
          <li>Approved document set (SOPs, manuals, policies, templates)</li>
          <li>Folder structure or source inventory</li>
          <li>Rules on what can and cannot be used</li>
          <li>Review and escalation expectations</li>
        </ul>
      </div>

      <div class="mt-8 flex flex-col sm:flex-row gap-4 items-start">
        <a href="https://cal.com/q-types/30-minute-discovery-call" class="btn-primary">
          Explore whether your documents could become a usable assistant
        </a>
        <a href="/case-studies/" class="text-brand-blue font-medium hover:underline flex items-center gap-1">
          See lesson planner case study
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Our Approach -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="container-narrow">
      <h2 class="text-2xl font-bold text-slate text-center">Our Approach to AI</h2>
      <p class="mt-4 text-center text-slate-light max-w-2xl mx-auto">
        We focus on practical AI that solves real problems—not impressive demos that don't work in production.
      </p>
      <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-5 rounded-lg border border-gray-200">
          <h3 class="font-semibold text-slate text-sm">Business-First</h3>
          <p class="mt-2 text-xs text-slate-light">We start with your workflows, not the technology.</p>
        </div>
        <div class="bg-white p-5 rounded-lg border border-gray-200">
          <h3 class="font-semibold text-slate text-sm">Right-Sized</h3>
          <p class="mt-2 text-xs text-slate-light">Solutions scaled to your needs and budget.</p>
        </div>
        <div class="bg-white p-5 rounded-lg border border-gray-200">
          <h3 class="font-semibold text-slate text-sm">Integrated</h3>
          <p class="mt-2 text-xs text-slate-light">AI that works with your existing systems.</p>
        </div>
        <div class="bg-white p-5 rounded-lg border border-gray-200">
          <h3 class="font-semibold text-slate text-sm">Maintainable</h3>
          <p class="mt-2 text-xs text-slate-light">Tools your team can use without data science expertise.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Ready to explore practical AI for your business?"
    description="Book a discovery call to discuss how intelligent tools could work for your operations."
  />

  <!-- Service Schema with multiple offers -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI & Intelligent Automation",
    "description": "Practical AI tools integrated into operations: NLP solutions and internal AI assistants grounded on your company documents.",
    "provider": {
      "@type": "ProfessionalService",
      "name": "QSol Analytics",
      "url": "https://qsol-analytics.com"
    },
    "areaServed": {
      "@type": "Country",
      "name": "United Kingdom"
    },
    "serviceType": "AI Consulting",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "AI & Intelligent Automation Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Lightweight NLP Solutions",
            "description": "Text classification, search, and extraction that scales"
          },
          "priceSpecification": {
            "@type": "PriceSpecification",
            "priceCurrency": "GBP",
            "minPrice": "5000",
            "maxPrice": "15000"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Internal AI Assistants",
            "description": "Grounded Q&A tools that cite your approved sources"
          },
          "priceSpecification": {
            "@type": "PriceSpecification",
            "priceCurrency": "GBP",
            "minPrice": "8000",
            "maxPrice": "25000"
          }
        }
      ]
    }
  })} />
</BaseLayout>
