---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout
  title="Customer Segmentation Services UK | QSol Analytics"
  description="Turn customer data into commercial action. Segmentation, churn prediction, and prioritised account lists for UK SMEs. Results in 4-8 weeks."
>
  <section class="py-16 lg:py-24">
    <div class="container-narrow">
      <h1 class="text-4xl font-bold text-slate">Customer Segmentation & Commercial Insight</h1>
      <p class="mt-6 text-xl text-slate-light">
        Customer analytics services for UK SMEs. We help you understand which customers are most valuable, which are drifting away, and where your team should focus first—using RFM analysis, clustering, and behavioural segmentation on your existing data.
      </p>
    </div>
  </section>

  <!-- Main Offer: Customer Segmentation -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="container-narrow">
      <div class="flex items-center gap-4 mb-4">
        <span class="text-sm font-medium text-brand-blue bg-brand-blue-pale px-3 py-1 rounded-full">4–8 weeks</span>
      </div>
      <h2 class="text-3xl font-bold text-slate">Turn Customer Data Into Commercial Action</h2>
      <p class="mt-4 text-lg text-slate-light">
        Using your transaction and engagement data, we group customers into meaningful segments and surface the accounts, prospects, or risks that deserve attention.
      </p>

      <div class="mt-8 grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="font-semibold text-slate text-lg">The Problem</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Marketing treats too many customers the same way
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Sales teams don't know who to prioritise
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              High-value dormant accounts are hidden in the data
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Retention opportunities are being missed
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-red-400 rounded-full mt-2 flex-shrink-0"></span>
              Customer understanding depends too much on anecdote
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-slate text-lg">What You Get</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Segment definitions with clear characteristics
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Customer scoring logic
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Actionable account lists
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Dashboard or interactive view
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Recommended next actions by segment
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-8 bg-white border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-slate">What This Helps You Do</h3>
        <ul class="mt-3 grid md:grid-cols-2 gap-3 text-sm text-slate-light">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-brand-blue mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            Identify dormant high-value customers for reactivation
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-brand-blue mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            Group customers by purchasing behaviour
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-brand-blue mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            Prioritise prospects that resemble best existing customers
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-brand-blue mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            Support customer success with churn-risk views
          </li>
        </ul>
      </div>

      <div class="mt-6 bg-green-50 border border-green-200 rounded-lg p-4">
        <p class="text-sm text-green-800">
          <strong>Typical results:</strong> 15-25% reduction in churn within 90 days of intervention. Clear prioritisation for sales and customer success teams. Improved targeting and marketing ROI.
        </p>
        <p class="text-xs text-green-700 mt-1 italic">Results vary by data quality. We agree success metrics upfront.</p>
      </div>

      <div class="mt-8 flex flex-col sm:flex-row gap-4 items-start">
        <a href="https://cal.com/q-types/30-minute-discovery-call" class="btn-primary">
          See what your customer data is hiding
        </a>
        <a href="/case-studies/" class="text-brand-blue font-medium hover:underline flex items-center gap-1">
          See customer clustering case study
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Supporting Capabilities -->
  <section class="py-16 lg:py-20">
    <div class="container-narrow">
      <h2 class="text-2xl font-bold text-slate">Supporting Capabilities</h2>
      <p class="mt-4 text-slate-light">
        Customer segmentation often leads to related work. We also build:
      </p>
      <div class="mt-8 grid md:grid-cols-3 gap-6">
        <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
          <h3 class="font-semibold text-slate">Recommendation Systems</h3>
          <p class="mt-2 text-sm text-slate-light">What to offer each customer, when, and through which channel—personalised at scale.</p>
        </div>
        <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
          <h3 class="font-semibold text-slate">Lead Scoring</h3>
          <p class="mt-2 text-sm text-slate-light">Prioritise inbound leads based on likelihood to convert, using interpretable features.</p>
        </div>
        <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
          <h3 class="font-semibold text-slate">Churn Prediction</h3>
          <p class="mt-2 text-sm text-slate-light">Identify at-risk customers before they leave, with time to intervene.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What You Need -->
  <section class="py-16 lg:py-20 bg-gray-50">
    <div class="container-narrow">
      <h2 class="text-2xl font-bold text-slate">What We Need From You</h2>
      <div class="mt-6 grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="font-semibold text-slate">Data Requirements</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-brand-blue mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Customer transaction history
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-brand-blue mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              CRM or engagement fields if available
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-brand-blue mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Account identifiers and time history
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-brand-blue mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Business view of what "high value" means
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-slate">Best-Fit Clients</h3>
          <ul class="mt-3 space-y-2 text-slate-light">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Businesses with recurring customers or accounts
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Businesses with sales, CRM, or transaction history
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-600 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              Teams that want sharper targeting and prioritisation
            </li>
          </ul>
        </div>
      </div>
      <p class="mt-6 text-slate-light">
        Don't have "clean" data? That's normal. Part of our work is making sense of messy reality.
      </p>
    </div>
  </section>

  <CTASection
    title="Ready to understand your customers better?"
    description="Book a discovery call to discuss how segmentation could sharpen your commercial focus."
  />

  <!-- Service Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Customer Segmentation & Commercial Insight",
    "description": "Turn customer data into commercial action. Segmentation, churn prediction, lead scoring, and recommendation systems for UK SMEs.",
    "provider": {
      "@type": "ProfessionalService",
      "name": "QSol Analytics",
      "url": "https://qsol-analytics.com"
    },
    "areaServed": {
      "@type": "Country",
      "name": "United Kingdom"
    },
    "serviceType": "Customer Analytics",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Customer Intelligence Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Customer Segmentation & Commercial Insight",
            "description": "Actionable segments, churn-risk views, and prioritised account lists"
          },
          "priceSpecification": {
            "@type": "PriceSpecification",
            "priceCurrency": "GBP",
            "minPrice": "6000",
            "maxPrice": "20000"
          }
        }
      ]
    }
  })} />
</BaseLayout>
