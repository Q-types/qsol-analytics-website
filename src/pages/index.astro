---
import BaseLayout from '../layouts/BaseLayout.astro';
import DataProjectFinder from '../components/DataProjectFinder.astro';

const caseStudies = [
  {
    headline: 'Cut quote times from hours to minutes',
    description: 'Bespoke manufacturer automated their estimating workflow, eliminating manual lookups and calculations.',
    outcome: 'Faster quotes, fewer errors, more capacity'
  },
  {
    headline: 'Turned customer data into sales priorities',
    description: 'Retail business used clustering to identify their most valuable customer segments and focus sales effort.',
    outcome: 'Better targeting, improved conversion'
  },
  {
    headline: 'Reduced repetitive reporting work',
    description: 'Consultancy automated data processing and report generation that was consuming hours each week.',
    outcome: 'Hours saved weekly, consistent outputs'
  },
  {
    headline: 'Built practical AI tools around real workflows',
    description: 'Education provider created an AI lesson planner that generates structured content from curriculum inputs.',
    outcome: 'Faster planning, better consistency'
  }
];

const frustrationOptions = [
  'Reports take too long to produce',
  'Spreadsheets are getting out of control',
  'We can\'t forecast or plan ahead',
  'Customer data exists but insight is weak',
  'Too much manual, repetitive work',
  'Not sure where to start with AI/ML',
  'Something else'
];
---

<BaseLayout
  title="The Data Team You Wish You Had | QSol Analytics"
  description="Get clearer reports, smarter forecasts, and practical AI tools without hiring an in-house data science team. QSol Analytics helps SMEs get the data-team advantage."
  hideHeader={true}
>
  <!-- Minimal Header -->
  <header class="absolute top-0 left-0 right-0 z-50 py-4">
    <div class="container-wide flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-white">QSol Analytics</a>
      <a
        href="#project-finder"
        class="bg-green-500 hover:bg-green-600 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm"
      >
        Find Your First Useful Data Solution
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0">
      <img
        src="/images/hero_back.png"
        alt="Small business team collaborating around data on screen"
        class="w-full h-full object-cover"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900/95 via-slate-900/80 to-slate-900/60"></div>
    </div>

    <div class="container-wide relative z-10 py-24 lg:py-32">
      <div class="max-w-2xl">
        <!-- Eyebrow -->
        <p class="text-green-400 font-medium text-sm tracking-wide uppercase mb-4">
          Big-company data tools for small-business teams
        </p>

        <!-- H1 -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-[1.1]">
          The Data Team<br/>You Wish You Had.
        </h1>

        <!-- Rotating Taglines -->
        <div class="mt-8 h-8 relative overflow-hidden">
          <div id="rotating-taglines" class="absolute inset-0">
            <p class="tagline text-xl text-gray-200 font-medium opacity-0 absolute inset-0 transition-opacity duration-500">Fix slow reports.</p>
            <p class="tagline text-xl text-gray-200 font-medium opacity-0 absolute inset-0 transition-opacity duration-500">Tame messy spreadsheets.</p>
            <p class="tagline text-xl text-gray-200 font-medium opacity-0 absolute inset-0 transition-opacity duration-500">Forecast with confidence.</p>
            <p class="tagline text-xl text-gray-200 font-medium opacity-0 absolute inset-0 transition-opacity duration-500">Make AI useful.</p>
          </div>
        </div>

        <!-- CTA -->
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a
            href="#project-finder"
            class="inline-flex items-center justify-center px-8 py-4 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-lg transition-colors text-lg"
          >
            Find Your First Useful Data Solution
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Data Project Finder Section -->
  <DataProjectFinder />

  <!-- Outcome-First Case Studies -->
  <section class="py-16 lg:py-20 bg-slate-800">
    <div class="container-wide">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-white">What this looks like in practice</h2>
        <p class="mt-4 text-gray-400">
          Real projects. Real outcomes. No fluff.
        </p>
      </div>
      <div class="mt-12 grid md:grid-cols-2 gap-8">
        {caseStudies.map((study) => (
          <div class="bg-slate-900 border border-slate-700 rounded-xl p-6 hover:border-green-500/50 transition-colors">
            <h3 class="text-lg font-semibold text-green-400">{study.headline}</h3>
            <p class="mt-3 text-gray-400 text-sm">{study.description}</p>
            <p class="mt-4 text-sm font-medium text-white">{study.outcome}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder Credibility -->
  <section class="py-16 lg:py-20 bg-slate-900">
    <div class="container-narrow">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-white">
          Who's behind QSol Analytics
        </h2>
        <div class="mt-8">
          <div class="w-20 h-20 bg-green-500 rounded-full mx-auto flex items-center justify-center text-white text-2xl font-bold">
            DM
          </div>
          <h3 class="mt-4 text-lg font-semibold text-white">David McCann</h3>
          <p class="text-gray-400 text-sm">Founder</p>
        </div>
        <p class="mt-6 text-gray-300 leading-relaxed">
          Physics-trained data science practitioner with applied machine learning and data science training from the University of Cambridge Institute of Continuing Education.
        </p>
        <p class="mt-4 text-gray-300 leading-relaxed">
          I build practical forecasting, reporting automation, and AI tools for small businesses, helping make data science and AI capability accessible without the cost of a full data team.
        </p>
        <p class="mt-4 text-gray-300 leading-relaxed">
          You work directly with me from diagnosis to implementation. No handoff to junior staff, no bloated consultancy process, and no overselling. If a spreadsheet fix is the right answer, I'll say so.
        </p>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section id="contact" class="py-16 lg:py-20 bg-slate-900">
    <div class="container-narrow">
      <div class="text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-white">
          Ready to talk about your data?
        </h2>
        <p class="mt-4 text-gray-300">
          Send a quick question or book a call—whichever feels easier.
        </p>
      </div>
      <div class="mt-10 max-w-lg mx-auto">
        <form class="space-y-4" action="https://formspree.io/f/your-form-id" method="POST">
          <div class="grid md:grid-cols-2 gap-4">
            <input
              type="text"
              name="name"
              placeholder="Your name"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-700 bg-slate-800 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500"
            />
            <input
              type="email"
              name="email"
              placeholder="Work email"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-700 bg-slate-800 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500"
            />
          </div>
          <input
            type="text"
            name="company"
            placeholder="Company name"
            class="w-full px-4 py-3 rounded-lg border border-gray-700 bg-slate-800 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500"
          />
          <select
            name="frustration"
            class="w-full px-4 py-3 rounded-lg border border-gray-700 bg-slate-800 text-white focus:outline-none focus:ring-2 focus:ring-green-500"
          >
            <option value="" disabled selected>What's your biggest data challenge?</option>
            {frustrationOptions.map((option) => (
              <option value={option}>{option}</option>
            ))}
          </select>
          <textarea
            name="message"
            placeholder="Tell me a bit about what you're dealing with... (optional)"
            rows="3"
            class="w-full px-4 py-3 rounded-lg border border-gray-700 bg-slate-800 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500"
          ></textarea>
          <button
            type="submit"
            class="w-full px-6 py-4 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-lg transition-colors"
          >
            Send a Quick Project Question
          </button>
        </form>
        <div class="mt-8 text-center">
          <p class="text-gray-400 text-sm mb-3">Or if you prefer to talk:</p>
          <a
            href="https://cal.com/q-types/30-minute-discovery-call"
            class="inline-flex items-center text-green-400 hover:text-green-300 font-medium"
          >
            Book a 30-minute discovery call
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Simple Footer -->
  <footer class="py-8 bg-slate-950">
    <div class="container-wide">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-gray-500 text-sm">
          &copy; 2024 QSol Analytics. All rights reserved.
        </p>
        <div class="flex gap-6 text-gray-500 text-sm">
          <a href="/privacy/" class="hover:text-gray-300">Privacy</a>
          <a href="/cookies/" class="hover:text-gray-300">Cookies</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "QSol Analytics",
    "url": "https://qsol-analytics.com",
    "logo": "https://qsol-analytics.com/images/logo.png",
    "description": "QSol Analytics helps small businesses get the data-team advantage without hiring a data team. Reporting automation, forecasting, customer intelligence, and practical AI tools.",
    "founder": {
      "@type": "Person",
      "name": "David McCann"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "david@qsol-analytics.com",
      "contactType": "sales"
    }
  })} />

  <!-- Rotating Taglines Animation -->
  <script>
    // Rotating taglines with fade animation
    const taglines = document.querySelectorAll('#rotating-taglines .tagline');
    let currentIndex = 0;
    const duration = 3000; // 3 seconds per tagline

    // Check for reduced motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function showTagline(index: number) {
      taglines.forEach((tagline, i) => {
        if (i === index) {
          (tagline as HTMLElement).style.opacity = '1';
        } else {
          (tagline as HTMLElement).style.opacity = '0';
        }
      });
    }

    function rotateTaglines() {
      currentIndex = (currentIndex + 1) % taglines.length;
      showTagline(currentIndex);
    }

    // Initialize first tagline
    if (taglines.length > 0) {
      showTagline(0);

      // Only animate if user doesn't prefer reduced motion
      if (!prefersReducedMotion) {
        setInterval(rotateTaglines, duration);
      }
    }
  </script>
</BaseLayout>
